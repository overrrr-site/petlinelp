{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd doutaku && npm install && npm run build",
  "outputDirectory": "doutaku/dist",
  "framework": null,
  "rewrites": [
    { "source": "/doutaku", "destination": "/index.html" },
    { "source": "/doutaku/(.*)", "destination": "/$1" }
  ]
}

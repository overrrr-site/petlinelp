{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd doutaku && npm install && npm run build",
  "outputDirectory": "doutaku/dist",
  "framework": null,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/(_astro|images)/(.*)", "destination": "/doutaku/$1/$2" },
    { "source": "/favicon.(ico|svg)", "destination": "/doutaku/favicon.$1" }
  ]
}

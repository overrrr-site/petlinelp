---
import { assetPath } from "../utils/assetPath";
interface Props { position: "hero" | "promo"; }
const { position } = Astro.props;
// Approved Figma lineup (70:18): original packages with exported silhouette masks.
const products = [
  { key: "care-dog", alt: "ドクターズケア 犬用 アミノプロテクトケア ポテト", width: 223.543,
    crop: [1321 / 2000, 1891 / 2000, 325 / 2000, 62 / 2000], mask: [220.99, 317.28, 1.192, 1.023], size: [2000, 2000] },
  { key: "care-cat", alt: "ドクターズケア 猫用 ストマックケア", width: 175.880,
    crop: [1030 / 2000, 1874 / 2000, 465 / 2000, 80 / 2000], mask: [173.25, 317.07, 1.378, 1.549], size: [2000, 2000] },
  { key: "dietics-dog", alt: "ダイエティクス 犬用 アレルゲンセレクトカット", width: 226.682,
    crop: [1217 / 2000, 1718 / 2000, 375 / 2000, 230 / 2000], mask: [223.39, 316.71, 1.735, 1.735], size: [2000, 2000] },
  { key: "dietics-cat", alt: "ダイエティクス 猫用 キドニーキープ", width: 193.669,
    crop: [975 / 2000, 1611 / 2000, 493 / 2000, 319 / 2000], mask: [190.3, 316.24, 1.685, 1.884], size: [2000, 2000] },
];
---
<div class:list={["lp-product-lineup", `lp-product-lineup--${position}`]}>
  {products.map((product, index) => {
    const [cropWidth, cropHeight, cropX, cropY] = product.crop;
    const [maskWidth, maskHeight, maskX, maskY] = product.mask;
    const maskStyle = `width:calc(${product.width * 600 / 948} * var(--unit));`
      + `mask-image:url("${assetPath(`/images/lineup/${product.key}.svg`)}");`
      + `mask-size:${maskWidth / product.width * 100}% ${maskHeight / 320 * 100}%;`
      + `mask-position:${maskX / (product.width - maskWidth) * 100}% ${maskY / (320 - maskHeight) * 100}%;`;
    return (
      <div class="lp-product-lineup__product" style={maskStyle}>
        <img src={assetPath(`/images/lineup/${product.key}.png`)} alt={product.alt}
          width={product.size[0]} height={product.size[1]}
          style={`width:${100 / cropWidth}%;height:${100 / cropHeight}%;left:${-cropX / cropWidth * 100}%;top:${-cropY / cropHeight * 100}%;`}
          loading={position === "hero" ? "eager" : "lazy"}
          fetchpriority={position === "hero" && index === 0 ? "high" : "auto"} decoding="async" />
      </div>
    );
  })}
</div>

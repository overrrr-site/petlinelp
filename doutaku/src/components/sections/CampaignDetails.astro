---
import {
  CAMPAIGN_CODE,
  CAMPAIGN_NAME,
  CAMPAIGN_PERIOD_END,
  CAMPAIGN_PERIOD_START,
  FREE_SHIPPING_THRESHOLD,
} from "../../data/campaign";
import FreeShippingOffer from "../FreeShippingOffer.astro";
import CampaignCoupon from "../CampaignCoupon.astro";
import { assetPath } from "../../utils/assetPath";

const terms = [
  {
    heading: "【キャンペーン対象】",
    items: [
      "どうぶつ病院宅配便アプリまたはサイトではじめて購入される方が対象です。",
      "会員登録済みの方も、はじめて購入される場合は本キャンペーンの対象となります。",
      "過去に一度でもご購入いただいている場合は、購入するブランドや製品が異なっても、本キャンペーンの対象にはなりませんので、ご了承ください。",
    ],
  },
  {
    heading: "【キャンペーン詳細】",
    items: [
      "どうぶつ病院宅配便で初めて商品をご購入いただくと、ご購入商品を「送料ペットライン負担」でお届けいたします。",
      "上記期間中の初回ご注文分が対象となります。",
      `ご注文時にキャンペーンコード【${CAMPAIGN_CODE}】の入力が必要です。`,
      `通常、1回のご注文金額が${FREE_SHIPPING_THRESHOLD}以上の場合、送料は当社負担となります。`,
      "在庫切れ等の理由により、本キャンペーンが適用されない場合がございます。",
      "ご注文画面でご不明な点がございましたら、どうぶつ病院宅配便　カスタマーセンターまでお問い合わせください。",
    ],
  },
];

const closingNotes = [
  "キャンペーンコードは1種類のみご利用可能です。他のキャンペーンコードとは併用できません。",
  "キャンペーンは予告なく変更・中止する場合があります。",
];
---
<section id="campaign-details" class="lp-details-section scroll-mt-4" aria-labelledby="campaign-details-heading">
  <div class="lp-stage lp-details">
    <h2 id="campaign-details-heading" class="lp-details__heading">
      <span class="sr-only">{CAMPAIGN_NAME}</span>
      <img src={assetPath("/images/figma/campaign-logo.svg")} alt="" width="759" height="175" loading="lazy" />
    </h2>
    <FreeShippingOffer variant="details" />
    <CampaignCoupon variant="details" />
    <div class="lp-details__period">
      <div class="lp-details__period-heading">
        <img src={assetPath("/images/figma/megaphone.svg")} alt="" width="92" height="72" loading="lazy" />
        <h3>キャンペーン期間</h3>
      </div>
      <p class="lp-details__start">{CAMPAIGN_PERIOD_START}</p>
      <p class="lp-details__end">{CAMPAIGN_PERIOD_END}</p>
    </div>
  </div>
  <div class="lp-details__terms flex flex-col gap-4 text-navy text-[15px] leading-[1.6]">
    {
      terms.map((block) => (
        <div class="flex flex-col gap-1">
          <p class="font-medium">{block.heading}</p>
          <ul class="flex flex-col">
            {block.items.map((line) => (
              <li class="flex gap-0.5">
                <span aria-hidden="true">※</span>
                <span class="flex-1">{line}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="flex flex-col gap-0.5">
      <p>どうぶつ病院宅配便　カスタマーセンター</p>
      <p>TEL　0120-600-131</p>
      <p>受付時間：9:00〜12:00、13:00〜17:00</p>
      <p>（土・日・祝日を除く）</p>
    </div>

    <ul class="flex flex-col">
      {
        closingNotes.map((line) => (
          <li class="flex gap-0.5">
            <span aria-hidden="true">※</span>
            <span class="flex-1">{line}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<div
  id="copyToast"
  role="status"
  aria-live="polite"
  class="pointer-events-none fixed bottom-[40px] left-1/2 -translate-x-1/2 z-50 rounded-full bg-navy/90 px-5 py-2.5 text-white text-sm font-bold opacity-0 transition-opacity duration-300"
>
  コードをコピーしました
</div>

<script>
  (function () {
    const toast = document.getElementById("copyToast");
    if (!toast) return;
    let timer: number | undefined;

    const showToast = () => {
      toast.style.opacity = "1";
      if (timer) window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        toast.style.opacity = "0";
      }, 1800);
    };

    document.querySelectorAll<HTMLElement>("[data-copy-code]").forEach((el) => {
      el.addEventListener("click", async () => {
        const code = el.dataset.copyCode;
        if (!code) return;
        try {
          await navigator.clipboard.writeText(code);
          showToast();
        } catch (e) {
          const ta = document.createElement("textarea");
          ta.value = code;
          ta.style.position = "fixed";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand("copy");
            showToast();
          } catch {}
          document.body.removeChild(ta);
        }
      });
    });
  })();
</script>

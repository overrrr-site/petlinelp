---
import { productCategories } from "../../data/products";
---

<section class="products" aria-labelledby="products-heading">
  <h2 id="products-heading" class="products__heading">取扱商品</h2>
  <div class="products__search">
    <img
      class="products__search-bg"
      src="/images/products/search-bg.svg"
      alt=""
      aria-hidden="true"
    />
    <h3 class="products__search-text">うちの子の症状から製品を探す</h3>
  </div>
  <div class="products__categories">
    <div
      class="products__category products__category--dog products__category--active"
      data-tab="dog"
    >
      <h3 class="products__category-label">犬用</h3>
      <img
        class="products__category-icon"
        src="/images/products/icon-dog.webp"
        alt="犬アイコン"
      />
    </div>
    <div class="products__category products__category--cat" data-tab="cat">
      <h3 class="products__category-label products__category-label--light">
        猫用
      </h3>
      <img
        class="products__category-icon"
        src="/images/products/icon-cat.webp"
        alt="猫アイコン"
      />
    </div>
  </div>
  <nav class="products__list">
    {
      productCategories.map((cat) => (
        <details
          class="products__accordion"
          data-pet={cat.pet}
          hidden={cat.pet === "cat"}
        >
          <summary class="products__item">
            <div class="products__item-content">
              <img
                class="products__item-icon"
                src="/images/products/check.svg"
                alt=""
              />
              <span class="products__item-name" set:html={cat.label} />
            </div>
            <span class="products__item-plus">+</span>
          </summary>
          <div class="products__detail">
            {cat.items.map((item) => (
              <div class="products__detail-entry">
                <img
                  class="products__detail-img"
                  src={item.src}
                  alt={item.alt}
                  loading="lazy"
                />
                <div class="products__detail-info">
                  <span
                    class:list={[
                      "products__detail-badge",
                      `products__detail-badge--${item.brand}`,
                    ]}
                  >
                    {item.brandLabel}
                  </span>
                  <h4
                    class:list={[
                      "products__detail-name",
                      `products__detail-name--${item.brand}`,
                    ]}
                  >
                    {item.name}
                  </h4>
                </div>
                <p class="products__detail-desc">{item.desc}</p>
              </div>
            ))}
          </div>
        </details>
      ))
    }
  </nav>
</section>

<style>
  .products {
    position: relative;
    padding: 50px 0 50px;
    background-color: #ebc6cb;
    font-family: "Zen Kaku Gothic New", Helvetica, sans-serif;
  }
  .products__heading {
    color: #161e3c;
    padding: 0;
    margin: 0 0 25px;
    font-size: 28px;
    font-weight: 700;
    text-align: center;
    line-height: normal;
  }
  .products__search {
    position: relative;
    width: 270px;
    margin: 0 auto 25px;
    text-align: center;
  }
  .products__search-bg {
    position: absolute;
    width: 100%;
    top: 0;
    left: 0;
    z-index: 0;
  }
  .products__search-text {
    font-size: 16px;
    font-weight: 700;
    color: #161e3c;
    text-align: center;
    position: relative;
    z-index: 1;
    padding: 6px 0 14px;
    line-height: normal;
    margin: 0;
  }
  .products__categories {
    display: flex;
    gap: 5px;
    padding: 0 14px;
    position: relative;
    z-index: 1;
    margin-bottom: -1px;
  }
  .products__category {
    position: relative;
    flex: 1;
    text-align: center;
    padding: 18px 10px 12px;
    min-height: 57px;
    box-sizing: border-box;
    border-radius: 8px 8px 0 0;
  }
  .products__category--active {
    background: #ffffff;
    z-index: 2;
  }
  .products__category:not(.products__category--active) {
    background: #9a9a9a;
    z-index: 1;
    margin-bottom: 1px;
    cursor: pointer;
  }
  .products__category-label {
    font-size: 20px;
    font-weight: 700;
    color: #161e3c;
    position: relative;
    z-index: 1;
    line-height: normal;
    margin: 0;
  }
  .products__category-label--light {
    color: #ffffff;
  }
  .products__category-icon {
    position: absolute;
    z-index: 1;
  }
  .products__category--dog .products__category-icon {
    width: 39px;
    height: 68px;
    bottom: 12px;
    left: 5px;
  }
  .products__category--cat .products__category-icon {
    width: 60px;
    height: 54px;
    bottom: 12px;
    right: 5px;
  }
  .products__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 16px 25px;
    background: #ffffff;
    margin: 0 14px;
    border-radius: 0 0 10px 10px;
    position: relative;
    z-index: 0;
  }
  .products__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border-radius: 5px;
    border: 1px solid #c5385f;
    width: 100%;
    min-height: 56px;
    padding: 10px 16px;
    text-decoration: none;
    transition: background-color 0.3s ease;
    box-sizing: border-box;
    cursor: pointer;
  }
  .products__item:hover,
  .products__item:focus {
    background-color: #f5f5f5;
  }
  .products__item-content {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .products__item-icon {
    width: 23px;
    height: 23px;
  }
  .products__item-name {
    font-size: 14px;
    font-weight: 700;
    color: #c5385f;
    line-height: 20px;
  }
  .products__item-plus {
    font-size: 22px;
    font-weight: 300;
    color: #c5385f;
    line-height: 1;
    flex-shrink: 0;
    margin-left: 8px;
    transition: transform 0.2s ease;
  }
  .products__accordion {
    width: 100%;
  }
  .products__accordion[hidden] {
    display: none;
  }
  .products__accordion summary {
    list-style: none;
  }
  .products__accordion summary::-webkit-details-marker {
    display: none;
  }
  .products__accordion[open] .products__item-plus {
    transform: rotate(45deg);
  }
  .products__accordion[open] .products__item {
    border-radius: 5px 5px 0 0;
    border-bottom: none;
  }
  .products__detail {
    background: #ffffff;
    border: 1px solid #c5385f;
    border-top: none;
    border-radius: 0 0 5px 5px;
    padding: 0 20px 20px;
  }
  .products__detail-entry {
    padding: 20px 0;
    display: grid;
    grid-template-columns: 100px 1fr;
    grid-template-rows: auto auto;
    gap: 0 16px;
  }
  .products__detail-entry + .products__detail-entry {
    border-top: 1px solid #eee;
  }
  .products__detail-img {
    width: 100px;
    height: 100px;
    border-radius: 4px;
    grid-row: 1 / 2;
    object-fit: contain;
  }
  .products__detail-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding-top: 4px;
  }
  .products__detail-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    color: #f6efe7;
    padding: 1px 12px;
    border-radius: 20px;
    line-height: normal;
  }
  .products__detail-badge--pink {
    background: #c5385f;
  }
  .products__detail-badge--blue {
    background: #2369d9;
  }
  .products__detail-badge--green {
    background: #6faa2d;
  }
  .products__detail-name {
    font-size: 20px;
    font-weight: 700;
    line-height: normal;
    margin: 0;
  }
  .products__detail-name--pink {
    color: #c5385f;
  }
  .products__detail-name--blue {
    color: #2369d9;
  }
  .products__detail-name--green {
    color: #6faa2d;
  }
  .products__detail-desc {
    font-size: 12px;
    font-weight: 500;
    color: #161e3c;
    line-height: 20px;
    margin: 12px 0 0;
    grid-column: 1 / -1;
  }
  .products__category--active .products__category-label {
    color: #161e3c;
  }
</style>

<script>
  (function () {
    const tabs = document.querySelectorAll<HTMLElement>(".products__category");
    const accordions =
      document.querySelectorAll<HTMLDetailsElement>(".products__accordion");
    if (!tabs.length || !accordions.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const pet = tab.dataset.tab;

        tabs.forEach((t) => {
          t.classList.remove("products__category--active");
        });
        tab.classList.add("products__category--active");

        tabs.forEach((t) => {
          const label = t.querySelector(".products__category-label");
          if (!label) return;
          if (t.classList.contains("products__category--active")) {
            label.classList.remove("products__category-label--light");
          } else {
            label.classList.add("products__category-label--light");
          }
        });

        accordions.forEach((acc) => {
          if (acc.dataset.pet === pet) {
            acc.removeAttribute("hidden");
          } else {
            acc.setAttribute("hidden", "");
            acc.removeAttribute("open");
          }
        });
      });
    });

    accordions.forEach((acc) => {
      acc.addEventListener("toggle", () => {
        if (acc.open) {
          accordions.forEach((other) => {
            if (other !== acc && other.dataset.pet === acc.dataset.pet) {
              other.removeAttribute("open");
            }
          });
        }
      });
    });
  })();
</script>

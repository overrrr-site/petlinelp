---
import { CAMPAIGN_END_SHORT, CAMPAIGN_NAME } from "../../data/campaign";
import { assetPath } from "../../utils/assetPath";
import FreeShippingOffer from "../FreeShippingOffer.astro";
import ProductLineup from "../ProductLineup.astro";
import CampaignCoupon from "../CampaignCoupon.astro";
import AppDownloadBadges from "../AppDownloadBadges.astro";
---
<section class="lp-promo-section" aria-labelledby="promo-heading">
  <div class="lp-stage lp-promo">
    <img class="lp-canvas" src={assetPath("/images/figma/promo-decoration.svg")} alt="" loading="lazy" />
    <h2 id="promo-heading" class="lp-promo__title">
      <span class="sr-only">{CAMPAIGN_NAME}</span>
      <img src={assetPath("/images/figma/campaign-logo.svg")} alt="" width="759" height="175" loading="lazy" />
    </h2>
    <FreeShippingOffer variant="promo" />
    <ProductLineup position="promo" />
    <div class="lp-promo__conditions">
      <p class="lp-promo__eligibility">初めてどうぶつ病院宅配便で<br />購入される方限定</p>
      <p class="lp-promo__period-label">キャンペーン期間</p>
      <p class="lp-promo__date">{CAMPAIGN_END_SHORT}</p>
    </div>
    <CampaignCoupon variant="promo" />
    <p class="lp-promo__download">アプリをダウンロード</p>
    <AppDownloadBadges position="promo" />
  </div>
  <aside class="lp-promo__loyalty" aria-label="常設特典">
    <p class="lp-promo__loyalty-label">さらに、いつでも</p>
    <p>ドライタイプは4個目購入時に<br /><strong>1個無料プレゼント</strong></p>
    <p class="lp-promo__loyalty-notes">※スタンプの有効期限は最終購入日から360日です。<br />※ウェットタイプは対象外です。</p>
  </aside>
</section>

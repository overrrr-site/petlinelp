---
import { SHOP_URL } from "../../data/links";
import { CAMPAIGN_CODE, CAMPAIGN_END_SHORT, FREE_SHIPPING_THRESHOLD } from "../../data/campaign";
import { assetPath } from "../../utils/assetPath";
import FreeShippingOffer from "../FreeShippingOffer.astro";
import ProductLineup from "../ProductLineup.astro";
import CampaignCoupon from "../CampaignCoupon.astro";
import AppDownloadBadges from "../AppDownloadBadges.astro";
import StoreRatings from "../StoreRatings.astro";
const notes = [
  "どうぶつ病院宅配便で初めてご購入される方が対象。過去に一度でもご購入されている場合は対象外です。",
  `期間: ${CAMPAIGN_END_SHORT}`,
  `通常、1回のご注文金額が${FREE_SHIPPING_THRESHOLD}以上の場合、送料は当社負担となります。`,
  `キャンペーンコード【${CAMPAIGN_CODE}】の入力が必要です。`,
];
---
<section class="lp-hero-section" aria-labelledby="hero-heading">
  <div class="lp-stage lp-hero">
    <img class="lp-canvas" src={assetPath("/images/figma/hero-decoration.svg")} alt="" />
    <img class="lp-hero__logo" src={assetPath("/images/hero/logo.webp")}
      alt="どうぶつ病院宅配便 / ペットライン株式会社" width="336" height="176" />
    <h1 id="hero-heading" class="lp-hero__heading">
      <svg class="lp-hero__rays lp-hero__rays--left" viewBox="0 0 24 44" fill="none" aria-hidden="true"><path d="M5 3 18 23M2 28 20 41" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      <span class="sr-only">どうぶつ病院宅配便 </span>初回 <strong>送料当社負担</strong>キャンペーン
      <svg class="lp-hero__rays lp-hero__rays--right" viewBox="0 0 24 44" fill="none" aria-hidden="true"><path d="M5 3 18 23M2 28 20 41" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </h1>
    <FreeShippingOffer variant="hero" />
    <ProductLineup position="hero" />
    <p id="hero-shipping-note" class="lp-hero__shipping-note"><span aria-hidden="true">※</span><span>沖縄県は通常送料が2,500円（税込）かかりますが、キャンペーンの参加で2,500円分の送料を当社が負担いたします。</span></p>
    <CampaignCoupon variant="hero" />
    <p class="lp-hero__member-note">会員登録には動物病院コードが必要です</p>
    <div class="lp-hero__cta-background" aria-hidden="true"></div>
    <img class="lp-canvas lp-hero__cta-decoration" src={assetPath("/images/figma/hero-cta-decoration.svg")} alt="" />
    <h2 class="lp-hero__cta-title">まずはアプリをダウンロード</h2>
    <AppDownloadBadges position="hero" />
    <a class="lp-hero__web" href={SHOP_URL} data-ec-link>Webサイトから購入する方はこちら</a>
  </div>
  <StoreRatings />
  <ul class="lp-hero__notes">
    {notes.map(line => <li><span aria-hidden="true">※</span><span>{line}</span></li>)}
    <li><span aria-hidden="true">※</span><span>詳細・注意事項は<a href="#campaign-details">キャンペーン詳細</a>をご確認ください。</span></li>
  </ul>
</section>
